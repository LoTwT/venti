{
  "name": "@ayingott/venti",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.5",
  "description": "venti",
  "author": "LoTwT <709937065@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/LoTwT/venti#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/venti.git"
  },
  "bugs": {
    "url": "https://github.com/LoTwT/venti/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "bin": {
    "venti": "./dist/bin/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "cli": "tsx ./src/bin/cli.js",
    "lint": "eslint .",
    "play": "pnpm -C playground run venti",
    "prepare": "simple-git-hooks",
    "prepublishOnly": "pnpm build",
    "prettier": "prettier --write .",
    "release": "bumpp && npm publish --access public",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "up": "taze latest -I -f",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@antfu/ni": "^30.3.0",
    "@clack/core": "^1.4.3",
    "@clack/prompts": "^1.7.0",
    "defu": "^6.1.7",
    "pkg-types": "^2.3.1"
  },
  "devDependencies": {
    "@ayingott/eslint-config": "^2.1.3",
    "@ayingott/prettier-config": "^2.1.11",
    "@ayingott/sucrose": "^0.1.0",
    "@types/envinfo": "^7.8.4",
    "@types/node": "^26.1.1",
    "@types/prompts": "^2.4.9",
    "bumpp": "^12.0.0",
    "cac": "^7.0.0",
    "chalk": "^5.6.2",
    "envinfo": "^7.21.0",
    "eslint": "^10.7.0",
    "execa": "^10.0.0",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.16.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "prettier": "@ayingott/prettier-config"
}
