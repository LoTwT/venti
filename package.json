{
  "name": "@ayingott/venti",
  "type": "module",
  "version": "2.0.0",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24"
  },
  "description": "venti",
  "author": "LoTwT <709937065@qq.com>",
  "license": "MIT",
  "homepage": "https://github.com/LoTwT/venti#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoTwT/venti.git"
  },
  "bugs": {
    "url": "https://github.com/LoTwT/venti/issues"
  },
  "keywords": [],
  "sideEffects": false,
  "bin": {
    "venti": "./dist/bin/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "cli": "node ./src/bin/cli.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "play": "pnpm -C playground run venti",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build",
    "release": "bumpp && npm publish --access public",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "up": "taze latest -I -f",
    "watch": "tsdown --watch"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@ayingott/sucrose": "^0.1.0",
    "@types/node": "^26.1.1",
    "@types/prompts": "^2.4.9",
    "bumpp": "^12.0.0",
    "chalk": "^5.6.2",
    "citty": "^0.2.2",
    "execa": "^10.0.0",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "prompts": "^2.4.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.16.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,graphql,html,json,json5,jsonc,less,md,mdx,scss,toml,yaml,yml}": "oxfmt --write --no-error-on-unmatched-pattern"
  }
}
